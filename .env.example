# ── App ──────────────────────────────────────────
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info
TZ=America/Recife

# ── API ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/dbname
JWT_SECRET=change-me-to-a-random-string

# ── Frontend ─────────────────────────────────────
DOMAIN=example.com
API_DOMAIN=api.example.com
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LETSENCRYPT_EMAIL=at@me.com

# ── LinkedIn Agent ──────────────────────────────
LINKEDIN_URL=https://www.linkedin.com/in/example/
LINKEDIN=true
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=
URL_TARGET=https://www.linkedin.com/in/example/recent-activity/all/
URL_ABOUT=https://www.linkedin.com/in/example/about/
PLAYWRIGHT_HEADLESS=false

# ── Sync ───────────────────────────────────────
# capture = pegar tudo | monitor = só novos | process = só classificar
SYNC_MODE=monitor
MAX_SCROLLS=80
CONSECUTIVE_DUPES_TO_STOP=5
SCROLL_DELAY_MIN=3
SCROLL_DELAY_MAX=8
PROCESS_COUNT=5
SYNC_PUSH_URL=
SYNC_PUSH_TOKEN=

# ── Docker networking ─────────────────────────
USE_EXTERNAL_NET=true
EXTERNAL_NET=innovation

# ── LLM Classifier ──────────────────────────────
# ollama = Ollama local | gemini = Gemini CLI (só disciplina/escola) |
# agy = Antigravity CLI (classificação completa, roda na própria VM)
CLASSIFIER=ollama

# ── Gemini CLI ──────────────────────────────────
# GEMINI_LOGIN: método de autenticação do Gemini CLI
#   key   = API key do Google AI Studio (https://aistudio.google.com/apikey)
#   oauth = OAuth interativo (requer rodar --gemini-setup ao menos uma vez)
GEMINI_LOGIN=key
# GEMINI_API_KEY: obrigatório quando GEMINI_LOGIN=key
GEMINI_API_KEY=
# GEMINI_MODEL: modelo usado pelo Gemini CLI (opcional)
# Deixar vazio = default do Gemini CLI
GEMINI_MODEL=

# ── agy (Antigravity CLI) ───────────────────────
# Autenticação via OAuth interativo — rode uma vez:
#   docker compose run --rm -it sync python sync.py --agy-setup
# O token persiste no volume gemini-config (o agy usa o mesmo diretório
# ~/.gemini que o Gemini CLI). AGY_MODEL/AGY_TIMEOUT são opcionais.
AGY_MODEL=
AGY_TIMEOUT=180

# ── Ollama (Local LLM) ──────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b-32k

# ── SMTP (future) ──────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
