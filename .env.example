# ── App ──────────────────────────────────────────
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# ── API ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/dbname
JWT_SECRET=change-me-to-a-random-string

# ── Frontend ─────────────────────────────────────
DOMAIN=example.com
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LinkedIn Agent ──────────────────────────────
LINKEDIN_URL=https://www.linkedin.com/in/example/
LINKEDIN=true
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=
URL_TARGET=https://www.linkedin.com/in/example/recent-activity/all/
URL_ABOUT=https://www.linkedin.com/in/example/about/
PLAYWRIGHT_HEADLESS=false

# ── Sync ───────────────────────────────────────
# capture = pegar tudo | monitor = só novos | process = só classificar
SYNC_MODE=monitor
MAX_SCROLLS=80
CONSECUTIVE_DUPES_TO_STOP=5
SCROLL_DELAY_MIN=3
SCROLL_DELAY_MAX=8
PROCESS_COUNT=5
SYNC_PUSH_URL=
SYNC_PUSH_TOKEN=

# ── Docker networking ─────────────────────────
USE_EXTERNAL_NET=true
EXTERNAL_NET=innovation

# ── Ollama (Local LLM) ──────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b-32k

# ── SMTP (future) ──────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
