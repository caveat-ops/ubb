FROM mcr.microsoft.com/playwright/python:v1.58.0-noble
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl xvfb dbus-x11 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g @google/gemini-cli \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.api.txt requirements.sync.txt ./
RUN pip install --no-cache-dir -r requirements.api.txt -r requirements.sync.txt

COPY app/ ./app/
COPY persona.md .
COPY sync.py .
COPY scheduler.sh .
RUN chmod +x scheduler.sh

# Entrypoint padrão: scheduler (roda 3x/dia nos horários do SYNC_SCHEDULE)
# Para execução manual: docker compose run --rm sync python sync.py --headless
ENTRYPOINT ["./scheduler.sh"]
